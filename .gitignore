# Simulator build products inside simulator output roots.
# Keep the rest of each sim_out_* tree visible: logs, traces, images,
# manifests, and preparation snapshots are evidence or reproducibility inputs.
sim_out_*/obj_*/
sim_out_*/obj_dir/
sim_out_*/**/obj_*/
sim_out_*/**/obj_dir/
